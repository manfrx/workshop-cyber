# Copie para config.env e ajuste. NUNCA commite o config.env real.
# (as senhas do lab e o caminho da chave sao placeholders aqui)

# ============================================================================
# Workshop Cyber — configuração da infra OCI (ajuste aqui, não nos scripts)
# ============================================================================
# Carregado por up.sh / up-tls.sh / down.sh. Todos os recursos recebem a tag
# abaixo, e o down.sh usa essa tag para saber o que derrubar.

# --- identificação / região ---
# COMPARTMENT_OCID vazio = usa a tenancy (raiz) do ~/.oci/config
COMPARTMENT_OCID=""
REGION="sa-saopaulo-1"
AD="YvZu:SA-SAOPAULO-1-AD-1"

# --- tag que marca TUDO deste workshop (chave do teardown) ---
TAG_KEY="workshop"
TAG_VALUE="cyber-ctf"

# --- nomes / rede ---
PREFIX="wkcyber"
VCN_CIDR="10.0.0.0/16"
PUBLIC_SUBNET_CIDR="10.0.1.0/24"    # mgmt VM (com IP público)
PRIVATE_SUBNET_CIDR="10.0.2.0/24"   # VMs de participante (sem IP público)

# De onde você vai administrar (SSH na mgmt + acesso web). Restrinja ao seu IP!
# Ex.: "203.0.113.10/32". 0.0.0.0/0 = qualquer um (inseguro — só para teste).
ADMIN_CIDR="0.0.0.0/0"   # restrinja ao seu IP antes de subir

# --- VM de GERENCIAMENTO (Linux x86: roda Docker + Guacamole + nginx) ---
# IMPORTANTE: x86 (não ARM) porque as imagens do Guacamole são só linux/amd64.
MGMT_SHAPE="VM.Standard.E4.Flex"
MGMT_OCPU=2
MGMT_MEM_GB=12
MGMT_IMAGE_OS="Canonical Ubuntu"
MGMT_IMAGE_OS_VERSION="22.04"
MGMT_LIMIT="standard-e4-core-count"         # usado no preflight

# --- VMs de PARTICIPANTE (Windows x86, acesso RDP via Guacamole) ---
PARTICIPANT_COUNT=18
PARTICIPANT_SHAPE="VM.Standard.E4.Flex"
PARTICIPANT_OCPU=2
PARTICIPANT_MEM_GB=16
PARTICIPANT_IMAGE_OS="Windows"
PARTICIPANT_IMAGE_OS_VERSION="Server 2022 Standard"
PARTICIPANT_LIMIT="standard-e4-core-count"  # usado no preflight

# --- credenciais do desktop Windows (criadas via cloudbase-init) ---
# Cadastradas também no Guacamole. A senha precisa atender à complexidade do
# Windows (maiúscula + minúscula + número + símbolo, >= 8). Troque antes!
RDP_USER="aluno"
RDP_PASS="CHANGE_ME_RDP_PASS"

# --- chave SSH (usada na mgmt Linux; o Windows ignora) ---
SSH_KEY="$HOME/.ssh/wkcyber"   # caminho da chave publica de administracao

# --- senha do admin do Guacamole ---
# vazio = gera aleatória no 1º deploy e salva em .state/guacadmin.pass.
# NUNCA fica a padrão (guacadmin): o configure-mgmt sempre troca.
GUAC_ADMIN_PASS=""

# --- isca do Cenário 3 (link "Baixar documento" na plataforma) ---
# vazio = configure-mgmt aponta para a mgmt automaticamente:
#   com TLS  -> https://<mgmt-ip>/documento
#   sem TLS  -> http://<mgmt-ip>:3003/documento
# Preencha se a vítima acessa por outro endereço (ex.: IP privado da mgmt
# a partir da própria VM Windows): "https://10.0.1.x/documento".
PHISHING_URL=""

# --- TLS (só o up-tls.sh usa) ---
# Por padrão gera certificado SELF-SIGNED (não depende de domínio nem CA, evita
# o erro de emissão). Para usar Let's Encrypt, preencha DOMAIN + LE_EMAIL e
# aponte o domínio para o IP público da mgmt ANTES de rodar.
DOMAIN=""                 # ex.: "workshop.suaempresa.com" (vazio = self-signed p/ o IP)
LE_EMAIL=""               # e-mail para o Let's Encrypt (só se DOMAIN preenchido)

# --- simulação do Cenário 3 (scripts/simulacao.ps1) ---
# Embarcada em cada VM Windows via cloud-init, roda como tarefa agendada no
# logon do usuário RDP (precisa de sessão interativa p/ a tela cheia), com o
# firewall local liberado nesta porta.
SIM_SCRIPT="../simulation/simulacao-tela-cheia.ps1"   # relativo à pasta infra-oci
SIM_PORT=10000

# --- Login do painel do instrutor (/admin na plataforma) ---
ADMIN_USER="admin"
ADMIN_PASS="CHANGE_ME_ADMIN_PASS"

# --- URL que o kiosk/lock-screen das VMs vai abrir (Cenário 3) ---
# Vazio = só o desktop Windows. Preencha quando o app do Cenário 3 existir.
# Ex.: "http://10.0.1.2:3003/documento"
LOCKSCREEN_URL=""
