# =====================================================================
#  Copie para .env e ajuste. NUNCA commite o .env.
# =====================================================================

# ---- Cenário 1 · MedClinic ----
C1_PORT=3000
C1_DB_HOST=db
C1_DB_PORT=3306
C1_DB_NAME=medclinic
C1_DB_USER=medclinic_app
C1_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
C1_APP_SECRET=CHANGE_ME_APP_SECRET

# Flag do Cenário 1 — injetada no seed. Não hardcode no schema.
C1_FLAG=CHANGE_ME_FLAG_C1

# ---- Cenário 2 · Meridian ----
C2_PORT=3001
C2_APP_SECRET=CHANGE_ME_APP_SECRET

# Flag do Cenário 2 — gravada em /root/flag.txt no build.
C2_FLAG=CHANGE_ME_FLAG_C2

# ---- Cenário 3 · Phishing ----
C3_PORT=3002
C3_WEBMAIL_SECRET=CHANGE_ME_APP_SECRET

# ---- Simulação de tela cheia ----
SIM_PORT=10000
